{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tanstack-router-hono-spa",
	"main": "src/api/index.ts",
	"compatibility_date": "2025-12-27",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	},
	"placement": {
		"mode": "smart"
	}
}
